cmake_minimum_required(VERSION 3.22)

get_filename_component(SOURCE_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
if(NOT WORKSPACE_ROOT)
    set(WORKSPACE_ROOT "${SOURCE_ROOT}/windows-build-workspace")
endif()
if(NOT MSBUILD)
    set(MSBUILD "C:/Program Files/Microsoft Visual Studio/18/Community/MSBuild/Current/Bin/MSBuild.exe")
endif()
if(NOT PLATFORM_TOOLSET)
    set(PLATFORM_TOOLSET v145)
endif()
if(NOT JOBS)
    set(JOBS 8)
endif()
set(_source "${SOURCE_ROOT}/external/mupdf")
set(_output "${WORKSPACE_ROOT}/build/thirdparty/mupdf/")
if(NOT SDK_PREFIX)
    set(SDK_PREFIX "${WORKSPACE_ROOT}/sdk")
endif()
set(_prefix "${SDK_PREFIX}/mupdf")
if(NOT EXISTS "${_source}/thirdparty/freetype/include/ft2build.h")
    message(FATAL_ERROR "Initialize the pinned sources: git submodule update --init --recursive external/mupdf")
endif()
file(MAKE_DIRECTORY "${_output}" "${_prefix}/lib" "${_prefix}/share/licenses")
execute_process(COMMAND "${MSBUILD}" "${_source}/platform/win32/bin2coff.vcxproj"
    /t:Build /v:minimal /nologo /p:Configuration=Release /p:Platform=Win32
    "/p:PlatformToolset=${PLATFORM_TOOLSET}" RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "MuPDF font embedding tool failed (${_result})")
endif()
execute_process(COMMAND "${MSBUILD}" "${_source}/platform/win32/mupdf.sln"
    /t:libmupdf "/m:${JOBS}" /v:minimal /nologo
    /p:Configuration=Release /p:Platform=x64 "/p:PlatformToolset=${PLATFORM_TOOLSET}"
    "/p:OutDir=${_output}"
    RESULT_VARIABLE _result)
if(NOT _result EQUAL 0)
    message(FATAL_ERROR "MuPDF SDK build failed (${_result})")
endif()
file(COPY "${_source}/include/mupdf" DESTINATION "${_prefix}/include")
file(COPY "${_source}/thirdparty/tesseract/include/tesseract" DESTINATION "${_prefix}/include/mupdf-thirdparty")
file(COPY "${_source}/scripts/tesseract/tesseract/version.h" DESTINATION "${_prefix}/include/mupdf-thirdparty/tesseract")
file(GLOB _libraries "${_output}/*.lib")
file(COPY ${_libraries} DESTINATION "${_prefix}/lib")
file(COPY "${_source}/COPYING" DESTINATION "${_prefix}/share/licenses")
message(STATUS "MuPDF SDK: ${_prefix}")
