# MuPDF's upstream MSVC static library includes its referenced libraries.
find_path(MuPDF_INCLUDE_DIR mupdf/fitz.h HINTS ${MuPDF_ROOT} PATH_SUFFIXES include)
find_library(MuPDF_LIBRARY NAMES mupdf libmupdf HINTS ${MuPDF_ROOT} PATH_SUFFIXES lib)
if(MuPDF_INCLUDE_DIR)
    file(STRINGS "${MuPDF_INCLUDE_DIR}/mupdf/fitz/version.h" _version REGEX "^#define FZ_VERSION \"")
    string(REGEX MATCH "[0-9]+\\.[0-9]+\\.[0-9]+" MuPDF_VERSION "${_version}")
endif()
include(FindPackageHandleStandardArgs)
find_package_handle_standard_args(MuPDF REQUIRED_VARS MuPDF_LIBRARY MuPDF_INCLUDE_DIR VERSION_VAR MuPDF_VERSION)
if(MuPDF_FOUND AND NOT TARGET MuPDF::MuPDF)
    add_library(MuPDF::MuPDF UNKNOWN IMPORTED)
    set_target_properties(MuPDF::MuPDF PROPERTIES IMPORTED_LOCATION "${MuPDF_LIBRARY}" INTERFACE_INCLUDE_DIRECTORIES "${MuPDF_INCLUDE_DIR}")
    if(WIN32)
        set_property(TARGET MuPDF::MuPDF PROPERTY INTERFACE_LINK_LIBRARIES "ws2_32;crypt32;bcrypt")
    endif()
endif()
mark_as_advanced(MuPDF_INCLUDE_DIR MuPDF_LIBRARY)
