---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head><meta charset="utf-8" /><meta name="viewport" content="width=device-width" /><title>Mengshee — User guide / 使用指南</title><meta name="description" content="Choose English or 简体中文 to read the Mengshee user guide. 选择语言，阅读 Mengshee 使用指南。" /></head>
<body>
<main><a class="brand" href="../">Mengshee</a><p class="eyebrow">USER GUIDE · 使用指南</p>
<h1>Your reading workspace.<br /><span lang="zh-CN">你的阅读工作台。</span></h1>
<p>Choose a language. Both editions cover the same features.<br /><span lang="zh-CN">选择语言。两个版本覆盖相同功能。</span></p>
<nav aria-label="Language / 语言">
<a href={`${base}/en/`} lang="en" hreflang="en" data-locale="en"><strong>English</strong><span>Read the user guide →</span></a>
<a href={`${base}/zh-cn/`} lang="zh-CN" hreflang="zh-CN" data-locale="zh-cn"><strong>简体中文</strong><span>阅读使用指南 →</span></a>
</nav>
<p id="last" aria-live="polite"></p>
<footer><a href="https://github.com/zhaiyusci/mengshee/releases/latest">Download / 下载</a><span> · </span><a href="https://github.com/zhaiyusci/mengshee">GitHub</a></footer>
</main>
<script>
  try {
    const last = localStorage.getItem('mengshee-guide-language');
    if (last === 'en' || last === 'zh-cn') {
      const status = document.getElementById('last');
      if (status) status.textContent = `Last used / 上次使用：${last === 'en' ? 'English' : '简体中文'}`;
    }
    document.querySelectorAll<HTMLAnchorElement>('[data-locale]').forEach(link => link.addEventListener('click', () => {
      try { localStorage.setItem('mengshee-guide-language', link.dataset.locale!); } catch {}
    }));
  } catch {}
</script>
<style>
:global(body){margin:0;background:#f5f3ec;color:#223b34;font-family:system-ui,sans-serif;line-height:1.65}
main{max-width:850px;padding:clamp(24px,7vw,80px);margin:auto}.brand{font-size:1.5rem;font-weight:750;text-decoration:none;color:inherit}.eyebrow{margin-top:4rem;font-size:.8rem;letter-spacing:.15em}h1{font-size:clamp(2rem,5vw,3.5rem);line-height:1.3;letter-spacing:-.03em}h1 span{font-weight:500}p{color:#4c5d53}nav{display:grid;grid-template-columns:1fr 1fr;gap:1rem;margin:2rem 0}nav a{display:flex;flex-direction:column;gap:1rem;padding:1.7rem;border:1px solid #a6b4a8;border-radius:12px;color:inherit;text-decoration:none;background:#fffdf6}nav a:hover{background:#e5eee5}nav strong{font-size:1.6rem}a:focus-visible{outline:3px solid #366657;outline-offset:5px}footer{margin-top:4rem}footer a{color:inherit}@media(max-width:540px){nav{grid-template-columns:1fr}}
</style>
</body></html>
